{
  "$schema": "./node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Alchemy",
  "version": "0.1.0",
  "identifier": "com.ryancircelli.wmp-legacy-visualizers",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": ".." }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
